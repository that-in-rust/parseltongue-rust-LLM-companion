--- a/crates/parser/src/grammar/expressions/atom.rs
+++ b/crates/parser/src/grammar/expressions/atom.rs
@@ -612,6 +612,9 @@ fn closure_expr(p: &mut Parser<'_>) -> CompletedMarker {
     }
     // test const_closure
     // fn main() { let cl = const || _ = 0; }
+
+    // test_err const_closure_missing_body
+    // fn f() { const move |x| }
     p.eat(T![const]);
     p.eat(T![static]);
     p.eat(T![async]);
diff --git a/crates/parser/src/grammar/items.rs b/crates/parser/src/grammar/items.rs
index eefad273ef..ace0f99df6 100644
--- a/crates/parser/src/grammar/items.rs
+++ b/crates/parser/src/grammar/items.rs
@@ -112,6 +112,16 @@ pub(super) fn opt_item(p: &mut Parser<'_>, m: Marker, is_in_extern: bool) -> Res
     // fn foo() { pub 92; }
     let has_visibility = opt_visibility(p, false);
 
+    // test const_closure_statement
+    // fn f() { const || () }
+    // fn f() { const move || () }
+    // fn f() { const |x: u8| x }
+    // fn f() { const move |x: u8| x }
+    // fn f() { const || (); const move || (); }
+    if !has_visibility && p.at(T![const]) && matches!(p.nth(1), T![move] | T![|]) {
+        return Err(m);
+    }
+
     let m = match opt_item_without_modifiers(p, m) {
         Ok(()) => return Ok(()),
         Err(m) => m,
